# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cachebot_db

# Redis
REDIS_URL=redis://localhost:6379/0

# App Settings
APP_ENV=development
DEFAULT_CURRENCY=BYN
MONTHLY_HOURS=168
DEFAULT_SAVINGS_PERCENT=20.0

# Tunnel for Mini App: localhostrun (works without VPN) | cloudflare
TUNNEL_PROVIDER=localhostrun
